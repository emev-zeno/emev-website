{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/tacoandchai",
      "destination": "/tacoandchai/index.html"
    },
    {
      "source": "/tacoandchai/",
      "destination": "/tacoandchai/index.html"
    },
    {
      "source": "/flick",
      "destination": "/flick/index.html"
    },
    {
      "source": "/flick/",
      "destination": "/flick/index.html"
    },
    {
      "source": "/fixitfirst",
      "destination": "/fixitfirst/index.html"
    },
    {
      "source": "/fixitfirst/",
      "destination": "/fixitfirst/index.html"
    }
  ]
}
